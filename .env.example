# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/walletflow?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Server Port
SERVER_PORT=8080

# === Rate Limiter ===
LOGIN_RATE_LIMIT_BLOCK_DURATION=5m
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_DURATION=1m

# === Password Reset ===
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password?token=
PASSWORD_RESET_EXPIRE_DURATION=30m

# === Verification Token ===
VERIFICATION_TOKEN_BASE_URL=http://localhost:8080/api/v1/auth/verify?token=
VERIFICATION_TOKEN_EXPIRE_DURATION=1d